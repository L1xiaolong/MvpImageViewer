import QmlProject

Project {
    mainFile: "App.qml"
    mainUiFile: "DesignPreview.ui.qml"

    importPaths: [
        ".",
        "../src/qml"
    ]

    QmlFiles {
        directory: "."
    }
    QmlFiles {
        directory: "../src/qml"
    }
    Files {
        filter: "qmldir"
        directory: "../src/qml"
    }
    ImageFiles {
        directory: "../assets/icons/ui"
    }
    Files {
        filter: "qtquickcontrols2.conf"
    }

    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QT_AUTO_SCREEN_SCALE_FACTOR: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    qt6Project: true
}
